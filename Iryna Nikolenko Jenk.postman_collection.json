				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					"\r",
					"pm.test(\"Response time is less than 1500ms\", function () {\r",
					"    pm.expect(pm.response.responseTime).to.be.below(1500);\r",
					"});\r",
					"\r",
					"pm.test(\"Response is valid JSON\", function () {\r",
					"    pm.response.to.be.withBody;\r",
					"    pm.response.to.be.json;\r",
					"});\r",
					"\r",
					"//  Перевірка тіла відповіді\r",
					"if (pm.response.withBody) {\r",
					"    const json = pm.response.json();\r",
					"    const expectedMsg = pm.iterationData.get(\"expectedMessage\");\r",
					"\r",
					"    //  ПЕРЕВІРКА СТАТУСУ ОК \r",
					"    if (pm.response.code === 200 || pm.response.code === 201) {\r",
					"        pm.test(\"Status is ok\", function () {\r",
					"            pm.expect(json.status).to.eql(\"ok\");\r",
					"        });\r",
					"    } \r",
					"\r",
					"    //  ПЕРЕВІРКА ДЛЯ НЕГАТИВНИХ ТЕСТІВ \r",
					"    else if (pm.response.code === 400 && expectedMsg) {\r",
					"        pm.test(\"Negative case: Status is error\", function () {\r",
					"            pm.expect(json.status).to.eql(\"error\");\r",
					"        });\r",
					"\r",
					"        pm.test(\"Negative case: Message matches\", function () {\r",
					"            pm.expect(json.message).to.include(expectedMsg.trim());\r",
					"        });\r",
					"    }\r",
					"}"
				]
			}
