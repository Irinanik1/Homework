		{
			"name": "3 - update password",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"function generatePassword() {\r",
							"    const min = 8;\r",
							"    const max = 15;\r",
							"\r",
							"    const letters = \"abcdefghijklmnopqrstuvwxyz\";\r",
							"    const lettersUpper = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";\r",
							"    const numbers = \"0123456789\";\r",
							"    const all = letters + lettersUpper + numbers;\r",
							"\r",
							"    const length = Math.floor(Math.random() * (max - min + 1)) + min;\r",
							"\r",
							"    let password = lettersUpper[Math.floor(Math.random() * lettersUpper.length)];\r",
							"    password += numbers[Math.floor(Math.random() * numbers.length)];\r",
							"\r",
							"    for (let i = 2; i < length; i++) {\r",
							"        password += all[Math.floor(Math.random() * all.length)];\r",
							"    }\r",
							"\r",
							"    return password;\r",
							"}\r",
							"\r",
							"pm.environment.set(\"newPassword\", generatePassword());"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"\r",
							"const jsonData = pm.response.json();\r",
							"const body = JSON.parse(pm.request.body.raw);\r",
							"\r",
							"//  Перевірка статус-коду \r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"//  Перевірка бізнес-логіки \r",
							"pm.test(\"Пароль та підтвердження у запиті збігаються\", function () {\r",
							"    pm.expect(body.password).to.eql(body.repeatPassword);\r",
							"});\r",
							"\r",
							"pm.test(\"Пароль у запиті відповідає вимогам довжини\", function () {\r",
							"    pm.expect(body.password.length).to.be.within(8, 15);\r",
							"});\r",
							"\r",
							"pm.test(\"співпадіння userId з актуальним юзером\", function () {\r",
							"    pm.expect(Number(jsonData.data.userId)).to.eql(Number(pm.environment.get(\"userId\")));\r",
							"});\r",
							"\r",
							"//  Оновлення пароля в оточенні для подальшого Login\r",
							"pm.environment.set(\"newPassword\", body.password);\r",
							"\r",
							"//  Перевірка схеми\r",
							"pm.test(\"Response matches JSON Schema\", function () {\r",
							"    const schema = {\r",
							"        \"type\": \"object\",\r",
							"        \"required\": [\"status\", \"data\"],\r",
							"        \"properties\": {\r",
							"            \"status\": { \"type\": \"string\" },\r",
							"            \"data\": { \r",
							"                \"type\": \"object\",\r",
							"                \"required\": [\"userId\"],\r",
							"                \"properties\": { \"userId\": { \"type\": \"number\" } }\r",
							"            }\r",
							"        }\r",
							"    };\r",
							"    pm.response.to.have.jsonSchema(schema);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
