		{
			"name": "7 -  create expense",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"console.log(\"EXPENSE PRE-REQ\");\r",
							"\r",
							"const carId = pm.environment.get(\"carId\");\r",
							"const carCreatedAt = pm.environment.get(\"carCreatedAt\");\r",
							"const baseUrl = pm.environment.get(\"baseUrl\");\r",
							"\r",
							"const sid = pm.cookies.get(\"sid\");\r",
							"if (!sid) {\r",
							"  console.warn(\"NO sid cookie -> RUN request 5 (login) in THIS environment, then 6, then 7\");\r",
							"\r",
							"console.log(\"baseUrl =\", baseUrl);\r",
							"console.log(\"carId =\", carId);\r",
							"console.log(\"carCreatedAt =\", carCreatedAt);\r",
							"console.log(\"cookie sid =\", sid ? \"[exists]\" : null);\r",
							"\r",
							"\r",
							"}\r",
							"\r",
							"if (!carId || !carCreatedAt) {\r",
							"  console.warn(\"carId/carCreatedAt is empty -> RUN request 6 (create car) before request 7\");\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"  //  Перевірка статусу\r",
							"pm.test(\"Status code is 200 or 201\", function () {\r",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
							"});\r",
							"\r",
							"const json = pm.response.json();\r",
							"\r",
							"//  Перевірка структури відповіді\r",
							"pm.test(\"Response has data object\", function () {\r",
							"    pm.expect(json.data).to.be.an(\"object\");\r",
							"});\r",
							"\r",
							"//  Перевірка наявності ID витрати\r",
							"pm.test(\"Expense id exists\", function () {\r",
							"    pm.expect(json.data.id).to.be.a(\"number\");\r",
							"});\r",
							"\r",
							"\r",
							"if (json.data && json.data.id) {\r",
							"    pm.environment.set(\"expenseId\", json.data.id);\r",
							"}\r",
							"\r",
							"//  Перевірка схеми\r",
							"pm.test(\"Response matches JSON Schema\", function () {\r",
							"    const schema = {\r",
							"        \"type\": \"object\",\r",
							"        \"required\": [\"status\", \"data\"],\r",
							"        \"properties\": {\r",
							"            \"status\": { \"type\": \"string\", \"enum\": [\"ok\"] },\r",
